//Banking Process using Setter and Getter Method 


public class BankAccount {
    private int bankaccoutno;
    private double balance;

    public void setBankaccoutno(int bankaccoutno){
        this.bankaccoutno=bankaccoutno;
    }
    public  void setBalance(double balance){
        this.balance = balance;
    }

    public int getBankaccoutno(){
        return bankaccoutno;
    }

    public double getBalance() {
        return balance;
    }

    public void deposit(double amount){
        balance+=amount;
        System.out.println(amount+"is deposited");
    }

    public void withdraw(double amount){
        if(amount<=balance){
            balance-=amount;
            System.out.println(amount+"is withdrawn");
        }else{
            System.out.println("Insufficient Balance");
        }
    }
}
public class Main {
    public  static void main(String args[]){

        BankAccount b = new BankAccount();
        b.setBankaccoutno(101);
        b.setBalance(500);
        b.deposit(100);
        b.withdraw(300);
        System.out.println("Accout Number :"+b.getBankaccoutno());
        System.out.println("Current Balance :"+b.getBalance());


    }
}
